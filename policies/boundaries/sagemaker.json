{
  "overrides": {
    "DenyAllPassRole": {
      "Sid": "DenyPassRoleExceptSageMaker",
      "Effect": "Deny",
      "Action": "iam:PassRole",
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringNotEquals": {
          "iam:PassedToService": "sagemaker.amazonaws.com"
        }
      }
    }
  }
}
