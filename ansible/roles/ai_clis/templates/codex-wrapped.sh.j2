#!/bin/bash
# Wrapped Codex CLI with audit logging

AUDIT_LOG="{{ clawdult_base_dir }}/logs/cli/codex.log"

# Log invocation
echo "{\"timestamp\":\"$(date -Iseconds)\",\"user\":\"$(whoami)\",\"command\":\"codex\",\"args\":\"$*\"}" >> "$AUDIT_LOG"

# Source environment
if [ -f "{{ clawdult_base_dir }}/config/agent.env" ]; then
    source "{{ clawdult_base_dir }}/config/agent.env"
fi

# Load API key from secrets if available
if [ -f "{{ clawdult_base_dir }}/secrets/openai-api-key" ]; then
    export OPENAI_API_KEY=$(cat "{{ clawdult_base_dir }}/secrets/openai-api-key")
fi

# Execute codex directly (not via symlink to avoid recursion)
exec /home/ubuntu/.npm-global/bin/codex "$@"
